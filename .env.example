APP_NAME="Smart Auditor"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
SERVER_PORT=8000
APP_URL=http://127.0.0.1:${SERVER_PORT}

APP_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=1900   # must stay above the classification job timeout (1800s)

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# AI provider: anthropic | gemini. Switching = CLASSIFIER_PROVIDER only (each provider keeps its own key and model);
# after changing it, run php artisan queue:restart (running workers keep the old settings).
# A key that is empty or <need-to-change> is missing: runs fail with a clear message before any AI call.
CLASSIFIER_PROVIDER=anthropic

# Anthropic (Claude). Models: claude-sonnet-5 (default), claude-haiku-4-5, claude-opus-5
ANTHROPIC_API_KEY=<need-to-change>
CLASSIFIER_ANTHROPIC_MODEL=claude-sonnet-5

# Google Gemini
GEMINI_API_KEY=<need-to-change>
CLASSIFIER_GEMINI_MODEL=gemini-3.8-flash
# low | medium | high: thinking tokens count against the output limit and are billed as output
CLASSIFIER_GEMINI_THINKING_LEVEL=low

CLASSIFIER_BATCH_SIZE=100
CLASSIFIER_CONCURRENCY=4
CLASSIFIER_LOG_DAYS=30

# Classification cache (docs/11): on after `php artisan migrate`
CLASSIFIER_CACHE=true
CLASSIFIER_CACHE_MIN_CONFIDENCE=90
CLASSIFIER_TAXONOMY_VERSION=3
# Accountant imports (docs/12): cost of revenue by function or by nature
CLASSIFIER_IMPORT_COST_OF_REVENUE=function
# The accountant's classification rules (docs/17); off only in the test suite.
CLASSIFIER_RULES=true
# A trial balance off by this or more (opening, movement or closing) is refused, full or partial.
CLASSIFIER_REJECT_UNBALANCED_FROM=1.00

# Financial statements generator (docs/14): template and line catalogue version
FS_TEMPLATE_VERSION=sa-ifrs-smes-3
# The most a statement total's whole-riyal rounding difference may be to go on a line.
FS_ROUNDING_LIMIT=5
# How a negative amount is written on screens and in files: parentheses (1,234) or minus -1,234
FS_NEGATIVES=parentheses
# Last year's statements as a PDF (docs/14): qpdf cuts the statements' pages out (install it: docs/08); a larger file is refused.
QPDF_BINARY=qpdf
PRIOR_PDF_MAX_KB=20480
PRIOR_PDF_MAX_PAGES=150
# Where the AI's answers on a PDF are kept, by the file's content (default storage/app/private/prior-statements/cache)
# PRIOR_PDF_CACHE=
OPENAI_API_KEY=
CLASSIFIER_OPENAI_MODEL=gpt-6-astra
